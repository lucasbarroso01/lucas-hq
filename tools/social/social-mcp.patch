+_FB_NATIVE = SCHEDULER_DB.parent / "fb_native.json"
+
+
+@mcp.tool()
+async def schedule_facebook_reel_native(
+    filename: str,
+    when: str,
+    description: str = "",
+) -> dict[str, Any]:
+    """Schedule a Facebook Page Reel with Meta's NATIVE scheduling (scheduled_publish_time).
+
+    The video is uploaded now and Meta publishes it at `when` — the computer does not
+    need to be on. The source file is NOT archived (an IG job may still need it).
+    `when`: ISO 8601 with offset/Z (e.g. 2026-10-31T11:00:00Z); 10 min to 30 days ahead.
+    """
+    try:
+        src = local_files.resolve_video(DATA_DIR, filename)
+        run_at = scheduler.parse_when(when)
+    except (LocalFileError, ValueError) as e:
+        return {"ok": False, "error": str(e)}
+    ts = int(run_at.timestamp())
+    log.info("schedule_facebook_reel_native file=%s at=%s", filename, run_at.isoformat())
+    async with _new_client() as client:
+        try:
+            raw = await client.publish_fb_reel_file(file_path=src, description=description or None, scheduled_publish_time=ts)
+        except Exception as e:
+            return _err("facebook native schedule failed", e)
+    rec = {"video_id": raw.get("video_id"), "filename": filename, "scheduled_for": run_at.isoformat(), "scheduled_publish_time": ts}
+    try:
+        items = json.loads(_FB_NATIVE.read_text()) if _FB_NATIVE.exists() else []
+        items.append(rec)
+        _FB_NATIVE.parent.mkdir(parents=True, exist_ok=True)
+        _FB_NATIVE.write_text(json.dumps(items, indent=1))
+    except Exception as e:  # noqa: BLE001
+        log.warning("could not record fb native schedule: %s", e)
+    return {"ok": True, **rec, "finish": raw.get("finish")}
+
+
+@mcp.tool()
+async def list_facebook_native_scheduled() -> dict[str, Any]:
+    """List FB Reels scheduled natively at Meta (from fb_native.json), with Meta's current status."""
+    items = json.loads(_FB_NATIVE.read_text()) if _FB_NATIVE.exists() else []
+    out = []
+    async with _new_client() as client:
+        page_token = await client.get_page_access_token()
+        for it in items:
+            try:
+                st = await client._request("GET", str(it["video_id"]), params={"fields": "status,scheduled_publish_time,published"}, token=page_token)
+            except Exception as e:  # noqa: BLE001
+                st = {"error": str(e)}
+            out.append({**it, "meta": st})
+    return {"ok": True, "count": len(out), "items": out}
+
