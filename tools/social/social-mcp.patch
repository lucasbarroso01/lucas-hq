+# --- Lucas HQ: staging via Supabase Storage ---------------------------------
+# With SUPABASE_STAGING_BUCKET set, the file is uploaded to that PRIVATE bucket at
+# publish time and Meta gets a signed URL valid for SUPABASE_SIGNED_URL_SECONDS
+# (default 3600). unstage() deletes the object once the publish call returns.
+# Keys come only from the environment (.env) and are never logged.
+_SB_PREFIX = "sb:"
+
+
+def _sb() -> tuple[str, str, str, int]:
+    """(bucket, url, key, ttl) read at call time (server.py loads .env after importing us)."""
+    return (os.getenv("SUPABASE_STAGING_BUCKET", "").strip(), os.getenv("SUPABASE_URL", "").strip().rstrip("/"),
+            os.getenv("SUPABASE_SERVICE_KEY", "").strip(), int(os.getenv("SUPABASE_SIGNED_URL_SECONDS", "3600")))
+
+
+def _sb_request(method: str, path: str, data: bytes | None = None, ctype: str | None = None) -> bytes:
+    import urllib.request  # noqa: PLC0415
+    _b, url, key, _t = _sb()
+    headers = {"apikey": key, "Authorization": f"Bearer {key}"}
+    if ctype:
+        headers["Content-Type"] = ctype
+    req = urllib.request.Request(f"{url}/storage/v1/{path}", data=data, method=method, headers=headers)
+    with urllib.request.urlopen(req, timeout=600) as r:
+        return r.read()
+
+
+def _stage_supabase(src: pathlib.Path) -> tuple[str, pathlib.Path, str]:
+    import json  # noqa: PLC0415
+    bucket, url, _k, ttl = _sb()
+    # Supabase free plan caps each object at 50 MB: re-encode a temporary copy to fit
+    limit = int(os.getenv("SUPABASE_MAX_BYTES", str(48 * 1024 * 1024)))
+    tmp = None
+    if src.stat().st_size > limit and src.suffix.lower() in VIDEO_EXTENSIONS:
+        import subprocess, tempfile  # noqa: E401, PLC0415
+        dur = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(src)],
+                                   capture_output=True, text=True, check=True).stdout.strip())
+        kbps = int(limit * 8 * 0.92 / dur / 1000) - 160
+        tmp = pathlib.Path(tempfile.mkstemp(suffix=".mp4")[1])
+        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(src), "-c:v", "libx264", "-preset", "medium", "-b:v", f"{kbps}k",
+                        "-maxrate", f"{int(kbps * 1.3)}k", "-bufsize", f"{kbps * 2}k", "-pix_fmt", "yuv420p",
+                        "-c:a", "aac", "-b:a", "128k", "-movflags", "+faststart", str(tmp)], check=True)
+    obj = f"{secrets.token_urlsafe(18)}/{quote(src.name, safe='')}"
+    ctype = "video/mp4" if src.suffix.lower() in {".mp4", ".m4v"} else "video/quicktime" if src.suffix.lower() == ".mov" else "application/octet-stream"
+    try:
+        _sb_request("POST", f"object/{bucket}/{obj}", (tmp or src).read_bytes(), ctype)
+    finally:
+        if tmp:
+            tmp.unlink(missing_ok=True)
+    signed = json.loads(_sb_request("POST", f"object/sign/{bucket}/{obj}",
+                                    json.dumps({"expiresIn": ttl}).encode(), "application/json"))
+    return _SB_PREFIX + obj, src, f"{url}/storage/v1{signed['signedURL']}"
+
